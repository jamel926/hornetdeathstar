from pymycobot.mycobot import MyCobot

mc = MyCobot('/dev/ttyTHS1', 1000000)

def toggleOn():
    """ On met le pin 2 à 1 pour allumer la GPIO """
    mc.set_basic_output(2, 1)
    print("La GPIO est allumé.")

def toggleOff():
    """ On met le pin 2 à 0 pour éteindre la GPIO """
    mc.set_basic_output(2, 0)
    print("La GPIO est éteint.")

def afficheEtatGPIO():
    """ Retourne l'état de la GPIO """
    etat = mc.get_basic_output(2)
    if etat == 1:
        print("La GPIO est allumé.")
    else:
        print("La GPIO est éteint.")
