import numpy as np
from pymycobot.mycobot import MyCobot

mc = MyCobot('/dev/ttyTHS1', 1000000)

def pointer_vers(x_obj, y_obj, z_obj, vitesse=30):
    # 1. Lire la position actuelle du bout du bras
    coords = mc.get_coords()
    x_r, y_r, z_r = coords[0], coords[1], coords[2]

    # 2. Calculer le vecteur direction
    dx = x_obj - x_r
    dy = y_obj - y_r
    dz = z_obj - z_r

    # 3. Normaliser
    norme = np.sqrt(dx**2 + dy**2 + dz**2)
    dx, dy, dz = dx/norme, dy/norme, dz/norme

    # 4. Calculer les angles en degrés
    ry = np.degrees(np.arctan2(dx, dz))   # rotation autour de Y (lacet)
    rx = np.degrees(np.arctan2(-dy, np.sqrt(dx**2 + dz**2)))  # inclinaison

    # 5. Envoyer la commande (on garde x, y, z du bras, on change juste l'orientation)
    mc.set_coords([x_r, y_r, z_r, rx, ry, 0], vitesse, 1)

# Exemple : pointer vers un objet en (200, 100, 50)
pointer_vers(200, 100, 50)